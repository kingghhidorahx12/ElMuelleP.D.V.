{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "El Muelle: iniciar desarrollo aislado",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/Start-Development.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "runOn": "folderOpen", "instanceLimit": 1 },
      "presentation": { "reveal": "never", "close": true },
      "problemMatcher": []
    }
  ]
}
