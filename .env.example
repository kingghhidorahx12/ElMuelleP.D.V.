# Por seguridad la app sólo escucha en este equipo. Usa un proxy HTTPS y cambia
# explícitamente HOST si alguna vez necesitas una instalación de red.
HOST=127.0.0.1
REQUIRE_HTTPS=false

# No necesitas configurar PINs aquí. En el primer arranque, la app pide la
# cuenta del dueño y crea una clave local de cifrado en data\.secrets.json.
# Respalda esa carpeta junto con la base de datos; no la subas a GitHub.
